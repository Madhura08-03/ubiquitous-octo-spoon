# .env.example
# ============
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Google Gemini API key (required for /ai/generate-statement primary path)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Rolling cache window for Gate 4 anti-spam (seconds). Default: 900 (15 min)
SPAM_WINDOW_SECS=900

# CORS origins (comma-separated). Use * for development only.
CORS_ORIGINS=*

# Server port
PORT=8000
