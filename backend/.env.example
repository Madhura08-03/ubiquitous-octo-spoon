# Application Configuration
APP_NAME=Samanvay API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Database Configuration (PostgreSQL primary, SQLite local fallback)
# For local SQLite: sqlite+aiosqlite:///./samanvay.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/samanvay
DATABASE_URL=sqlite+aiosqlite:///./samanvay.db

# Authentication / JWT
JWT_SECRET_KEY=change-me-in-development-only-replace-in-production-with-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Integration / CORS
FRONTEND_URL=http://localhost:3000
